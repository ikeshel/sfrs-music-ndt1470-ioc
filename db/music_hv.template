# Monitoring and setpoint control for one MUSIC field cage.
#
# i.keshelashvili@gsi.de
#
# P      EPICS prefix, e.g. SFRS:FHF1:MUSIC1:
# FC     field-cage number, 1..3
# PORT   asyn port name
# BD     two-digit CAEN local-bus address
# CH     CAEN channel, 0..2
# VMAX   maximum voltage accepted through EPICS, volts
# IMAX   maximum current limit accepted through EPICS, microamperes

record(bo, "$(P)FC$(FC):HV_ENABLE")
{
    field(DESC, "HV output enable")
    field(DTYP, "stream")
    field(OUT,  "@caen_ndt1470.proto setEnable($(BD),$(CH)) $(PORT)")

    field(ZNAM, "OFF")
    field(ONAM, "ON")

    # Never automatically energize HV when the IOC starts.
    field(PINI, "NO")
}
alias ($(P)FC$(FC):HV_ENABLE, $(P)FC$(FC):HV_ENABL)
alias ($(P)FC$(FC):HV_ENABLE, $(P)FC$(FC):HV_ON_OFF)
alias ($(P)FC$(FC):HV_ENABLE, $(P)FC$(FC):HV_ON)
alias ($(P)FC$(FC):HV_ENABLE, $(P)FC$(FC):HV_OFF)

record(longin, "$(P)FC$(FC):HV_STATUS")
{
    field(DESC, "Raw CAEN status bitmask")
    field(DTYP, "stream")
    field(INP,  "@caen_ndt1470.proto getStatus($(BD),$(CH)) $(PORT)")
    field(SCAN, "1 second")
}
alias ($(P)FC$(FC):HV_STATUS, $(P)FC$(FC):HV_STATE)
alias ($(P)FC$(FC):HV_STATUS, $(P)FC$(FC):HV_STAT)

record(ao, "$(P)FC$(FC):HV_V_SET")
{
    field(DESC, "HV voltage setpoint")
    field(DTYP, "stream")
    field(OUT,  "@caen_ndt1470.proto setVSet($(BD),$(CH)) $(PORT)")
    field(SCAN, "Passive")
    field(EGU,  "V")
    field(PREC, "1")
    field(DRVL, "0")
    field(DRVH, "$(VMAX)")
    field(LOPR, "0")
    field(HOPR, "$(VMAX)")
    field(PINI, "NO")
}

record(ai, "$(P)FC$(FC):HV_V_RBV")
{
    field(DESC, "Measured HV voltage")
    field(DTYP, "stream")
    field(INP,  "@caen_ndt1470.proto getVMon($(BD),$(CH)) $(PORT)")
    field(SCAN, "1 second")
    field(EGU,  "V")
    field(PREC, "1")
    field(HOPR, "$(VMAX)")
    field(LOPR, "-1")
    field(LOW,  "0")
    field(LOLO,  "0")
    field(HIGH, "$(VMAX)*0.9")
    field(HIHI, "$(VMAX)")
}

record(ao, "$(P)FC$(FC):HV_I_SET")
{
    field(DESC, "HV current-limit setpoint")
    field(DTYP, "stream")
    field(OUT,  "@caen_ndt1470.proto setISet($(BD),$(CH)) $(PORT)")
    field(SCAN, "Passive")
    field(EGU,  "uA")
    field(PREC, "2")
    field(DRVL, "0")
    field(DRVH, "$(IMAX)")
    field(LOPR, "0")
    field(HOPR, "$(IMAX)")
    field(PINI, "NO")
}

record(ai, "$(P)FC$(FC):HV_I_RBV")
{
    field(DESC, "Measured HV current")
    field(DTYP, "stream")
    field(INP,  "@caen_ndt1470.proto getIMon($(BD),$(CH)) $(PORT)")
    field(SCAN, "1 second")
    field(EGU,  "uA")
    field(PREC, "3")
    field(HOPR, "$(IMAX)")
    field(LOPR, "-1")
    field(LOW,  "0")
    field(LOLO,  "0")
    field(HIGH, "0.9*$(IMAX)")
    field(HIHI, "$(IMAX)")
}

record(ao, "$(P)FC$(FC):HV_RAMP_UP_SET")
{
    field(DESC, "HV ramp-up speed")
    field(DTYP, "stream")
    field(OUT,  "@caen_ndt1470.proto setRampUp($(BD),$(CH)) $(PORT)")

    field(EGU,  "V/s")
    field(PREC, "0")
    field(DRVL, "1")
    field(DRVH, "500")
    field(LOPR, "1")
    field(HOPR, "500")

    field(VAL,  "$(RUP_DEFAULT=1)")
    field(PINI, "YES")
}

record(ao, "$(P)FC$(FC):HV_RAMP_DOWN_SET")
{
    field(DESC, "HV ramp-down speed")
    field(DTYP, "stream")
    field(OUT,  "@caen_ndt1470.proto setRampDown($(BD),$(CH)) $(PORT)")

    field(EGU,  "V/s")
    field(PREC, "0")
    field(DRVL, "1")
    field(DRVH, "500")
    field(LOPR, "1")
    field(HOPR, "500")

    field(VAL,  "$(RDW_DEFAULT=2)")
    field(PINI, "YES")
}